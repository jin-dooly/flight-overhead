# 서버 포트. MQTT도 같은 포트의 /mqtt 경로(WebSocket)로 열림
PORT=4000
# 격자별 폴링 간격(ms). 연속 실패 시 최대 60초까지 자동으로 늘어남
POLL_INTERVAL_MS=5000
# 외부 API 조회 반경(해리). 17해리 ≈ 31km, 지도에서 보이는 최대 반경 30km를 덮음
RADIUS_NM=17
# 외부 API 요청에 붙이는 User-Agent. 비워 두면 flight-overhead/0.1
USER_AGENT=flight-overhead/0.1

# 서버 전체에서 동시에 따라갈 수 있는 기체 수 (기본 20). 넘으면 새 기체 따라가기를 거절
MAX_FOLLOWS=20
# 따라가기 기체 조회 간격(ms) (기본 5초)
FOLLOW_POLL_INTERVAL_MS=5000
